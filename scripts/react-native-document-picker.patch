@@ -0,0 +1,39 @@
+package com.reactnativedocumentpicker;
+
+import android.os.AsyncTask;
+import com.facebook.react.bridge.JSExceptionHandler;
+
+/**
+ * React Native removed com.facebook.react.bridge.GuardedResultAsyncTask in 0.81.
+ * This is the same class, kept with the one module that still uses it.
+ */
+abstract class GuardedResultAsyncTask<Result> extends AsyncTask<Void, Void, Result> {
+  private final JSExceptionHandler mExceptionHandler;
+
+  protected GuardedResultAsyncTask(JSExceptionHandler exceptionHandler) {
+    mExceptionHandler = exceptionHandler;
+  }
+
+  @Override
+  protected final Result doInBackground(Void... params) {
+    try {
+      return doInBackgroundGuarded();
+    } catch (RuntimeException e) {
+      mExceptionHandler.handleException(e);
+      throw e;
+    }
+  }
+
+  @Override
+  protected final void onPostExecute(Result result) {
+    try {
+      onPostExecuteGuarded(result);
+    } catch (RuntimeException e) {
+      mExceptionHandler.handleException(e);
+    }
+  }
+
+  protected abstract Result doInBackgroundGuarded();
+
+  protected abstract void onPostExecuteGuarded(Result result);
+}
